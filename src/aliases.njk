---
pagination:
  data: collections.aliases
  size: 1
  alias: redirect
permalink: "{{ redirect.path }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="refresh" content="0; url={{ redirect.target | url }}">
    <link rel="canonical" href="{{ redirect.target | url }}">
    <title>{{ redirect.title }} · djub</title>
  </head>
  <body>
    <h1>{{ redirect.title }}</h1>
    <p><a href="{{ redirect.target | url }}">Continue to the event page</a></p>
  </body>
</html>
